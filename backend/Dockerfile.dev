FROM node:22-alpine

WORKDIR /app

# Install build tools jika ada modul native
RUN apk add --no-cache libc6-compat

# Copy manifests
COPY package*.json ./
COPY prisma ./prisma/

# Install dependencies
RUN npm install

# Copy source code
COPY . .

# Generate Prisma Client
RUN npx prisma generate || true

EXPOSE 4000

CMD ["npm", "run", "dev"]

